# Copy to .env for local development. Never commit .env.
HEARTH_ENV=development
HEARTH_ADDR=:8080
HEARTH_BASE_URL=http://localhost:8080
HEARTH_DB_PATH=./data/hearth.db

# Secret used to sign cookies (HMAC). Generate with: openssl rand -hex 32
HEARTH_COOKIE_SECRET=

# Resend (email). Leave RESEND_API_KEY blank in development to use the stub.
RESEND_API_KEY=
HEARTH_EMAIL_FROM=Hearth <noreply@hearth.app>

# Cloudflare R2 (media). Leave blank until configured; profile photo upload will be disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=
